# Plantilla del .env de STAGING. Copiar como .env.staging y completar los
# secretos desde el .env de producción.
#
#   cp .env.staging.example .env.staging
#
# Diferencias con producción, y son las que importan:
#   - TWILIO_HABILITADO=false  -> no sale ni un WhatsApp a socios reales.
#   - Sin claves VAPID         -> las push quedan apagadas solas.
#   - Carpeta de reintegros propia, para no ensuciar la de producción.
#   - CORS_EXTRA_ORIGINS con el origen privado del front de pruebas.

# El proxy TLS publica el 3010 hacia afuera; adentro el Nest escucha el 3000.
PORT=3000

# ---------------------------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------------------------
# ATENCIÓN: hoy es la MISMA base que producción. Todo lo que se pruebe queda
# escrito en datos reales. Reemplazar en cuanto exista la copia.
DB_USER=
DB_NAME=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DATABASE_URL=

# ---------------------------------------------------------------------------
# NOTIFICACIONES: APAGADAS
# ---------------------------------------------------------------------------
# Con esto en false el TwilioService usa un cliente simulado: loguea el mensaje
# y no llama a la API de Twilio. Las credenciales pueden ir vacías.
TWILIO_HABILITADO=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_OTP_TEMPLATE_SID=
TWILIO_NOTIFICATION_CREDENTIAL_ACTIVE=

# Las claves VAPID van vacías a propósito: PushNotificationsService detecta que
# faltan y deshabilita el envío por su cuenta.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------------------------------------------------------------------------
# REDIS PROPIO DE STAGING
# ---------------------------------------------------------------------------
REDIS_HOST=redis-stg
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# STAGING
# ---------------------------------------------------------------------------
# Mismo secreto que producción solo si querés reusar tokens; distinto es más
# prudente, así una sesión de staging no vale en producción.
JWT_SECRET=

# El front de pruebas no vive bajo cirsubgn.org.ar, hay que permitirlo a mano.
CORS_EXTRA_ORIGINS=https://192.168.1.2:4300

# Carpeta separada: las pruebas no se mezclan con la documentación real.
REINTEGROS_UPLOAD_PATH=/usr/local/proyectos/docsreintegros-stg
